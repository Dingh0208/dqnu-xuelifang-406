# 学立方后端环境配置（复制为 .env 后按需修改）
# .env 已被 .gitignore 忽略，不要提交真实密码

PORT=3100
HOST=127.0.0.1

# MySQL：本机安装版服务 MySQL80，默认端口 3306
# 如改用自建实例，把 DB_PORT/DB_USER/DB_PASSWORD 换成对应值即可
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=xlf
DB_PASSWORD=xlf123456
DB_NAME=xuelifang

# JWT
JWT_SECRET=please-change-this-in-production
JWT_EXPIRES_IN=12h

# 初始化数据库时使用的 root 账号（node scripts/init-db.js 会用到）
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=root123456
