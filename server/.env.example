# 学立方后端环境配置（复制为 .env 后按需修改）
# .env 已被 .gitignore 忽略，不要提交真实密码

PORT=3100
HOST=127.0.0.1

# MySQL（默认指向 server/mysql 下的便携实例，端口 3307）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=xlf
DB_PASSWORD=xlf123456
DB_NAME=xuelifang

# JWT
JWT_SECRET=please-change-this-in-production
JWT_EXPIRES_IN=12h

# 首次初始化数据库时使用的 root 账号（initialize-insecure 后为空密码）
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=
